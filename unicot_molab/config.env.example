# Copy to unicot_molab/config.env only if you want to override defaults.
# config.env is gitignored and must never contain a token you intend to commit.

export SHARED_ROOT="${SHARED_ROOT:-/workspace/unicot_unimmmu_shared}"
export OUTPUT_NAME="${OUTPUT_NAME:-unicot_native_v02}"
export GIT_SYNC_INTERVAL="${GIT_SYNC_INTERVAL:-900}"
export MAX_REFLECTIONS="${MAX_REFLECTIONS:-20}"
export MAX_GPU_MEMORY="${MAX_GPU_MEMORY:-90GiB}"
export HF_HOME="${HF_HOME:-$SHARED_ROOT/hf_cache}"
